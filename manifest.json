{
  "manifest_version": 3,
  "name": "CrossPoint Studio — Xteink X3 · X4 · X4 Pro",
  "short_name": "CrossPoint Studio",
  "version": "1.0.0",
  "description": "Turn any image into a pixel-exact BMP sleep screen for Xteink X3, X4 and X4 Pro readers running CrossPoint firmware. Convert, dither, download or send over Wi-Fi.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "CrossPoint Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "downloads", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "open-studio": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open CrossPoint Studio"
    }
  }
}
